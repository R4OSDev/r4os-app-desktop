R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=R4DESK
VERSION=0.1.32
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
TARGET=/R4OS/SOFTWARE/DESKTOP/R4DESK.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4DEV:Query:1
META=app.role=desktop_host
META=memory.profile=desktop
META=memory.tag=desktop
META=feature=direct-indexed8-scaling
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:TIME_V1:1
IMPORT=R4STD:CONFIG_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
IMPORT=R4IMG:API_V1:1
ZIG_MODULE=r4img:../../Libraries/R4IMG/Bindings/Zig/r4img.zig
