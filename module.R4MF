R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=R4DESK
VERSION=0.1.75
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
TARGET=/R4OS/SOFTWARE/DESKTOP/R4DESK.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4DEV:Query:1
META=app.role=desktop_host
META=memory.profile=desktop
META=memory.tag=desktop
META=feature=direct-indexed8-scaling
META=feature=direct-xrgb32-scaling
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:TIME_V1:1
IMPORT=R4STD:CONFIG_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
IMPORT=R4IMG:API_V1:1
IMPORT=R4IMG:PNG_V1:1
IMPORT=R4IMG:RASTER_V1:1
ZIG_MODULE=r4img:../../Libraries/R4IMG/Bindings/Zig/r4img.zig
IMPORT=R4GFX:DEVICE_V1:10
IMPORT=R4GFX:COLOR_V1:4
IMPORT=R4NV:BACKEND_V1:3:1
IMPORT=R4AMD:BACKEND_V1:3:1
IMPORT=R4AMD:IMAGE_V1:1:1
IMPORT=R4ENC:ENCODE_V1:1:1
ZIG_MODULE=r4gfx:../../Libraries/R4GFX/Bindings/Zig/r4gfx_abi.zig
ZIG_MODULE=r4gfx_desktop_outputs:../../Libraries/R4GFX/Display/desktop_outputs.zig
ZIG_MODULE=r4gfx_readback:../../Libraries/R4GFX/Display/readback.zig
ZIG_MODULE=r4enc:../../Libraries/R4ENC/Bindings/Zig/r4enc.zig
ZIG_MODULE=r4enc_recording_mux:../../Libraries/R4ENC/Bindings/Zig/recording_mux.zig
ZIG_MODULE=r4enc_recording_pixels:../../Libraries/R4ENC/Bindings/Zig/recording_pixels.zig
